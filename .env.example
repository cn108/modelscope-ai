# ModelScope AI — local development environment template.
#
# Copy this file to the repository root and replace the placeholder values:
#   cp .env.example .env
#
# .env is ignored by git and must never be committed. Compose reads it from the
# repository root; use:
#   docker compose -f infrastructure/docker-compose.yml --env-file .env up --build

# --- Django ---------------------------------------------------------------
# Generate a real value for anything beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=modelscope
POSTGRES_USER=modelscope
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# Compose overrides the host with the internal `db` service name.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Unit-test convenience only. Leave unset for Compose; PostgreSQL is the source
# of truth.
# DATABASE_ENGINE=sqlite

# --- Redis / Celery -------------------------------------------------------
# Compose overrides this with redis://redis:6379/0 inside containers.
REDIS_URL=redis://localhost:6379/0
# Leave these unset so both fall back to REDIS_URL. If you set them, use the
# Compose-internal hostname (`redis`) for container runs.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- API / authentication -------------------------------------------------
JWT_ACCESS_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://localhost:8080

# Login/model-call throttles. Use a higher limit only with a trusted proxy in
# front of the API. Login is keyed by client address and hashed email.
RATE_LIMIT_LOGIN=10/min
RATE_LIMIT_MODEL_CALL=30/min
RATE_LIMIT_EVALUATION_CREATE=30/hour

# --- Product metadata (Settings → About) ----------------------------------
APP_VERSION=1.0.0
DJANGO_ENVIRONMENT=development
DOCUMENTATION_URL=
SUPPORT_URL=

# --- Provider credential encryption (Milestone 3) ------------------------
# Comma-separated Fernet keys, current key first. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before a Z.ai API key can be stored. All configured keys can decrypt;
# the first key is used for new secrets. Never commit this value.
PROVIDER_SECRET_KEYS=

# --- Provider transport reliability ---------------------------------------
# Timeout and bounded retries for model calls. Concurrency is per worker
# process; scale workers rather than setting this very high.
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.25
PROVIDER_MAX_CONCURRENCY=8
PROVIDER_CONCURRENCY_WAIT_SECONDS=5

# --- Evaluation -----------------------------------------------------------
# Expose DeepEval judge metrics when the dependency is installed. Set to false
# to hide them entirely (for example, to avoid judge model calls/costs).
EVALUATION_JUDGE_METRICS_ENABLED=true

# --- Security scan / AI security testing limits ---------------------------
# Caps keep a single scan or test run from becoming an unbounded job.
SECURITY_MAX_SCAN_ITEMS=10000
SECURITY_TEST_MAX_MODELS=5
SECURITY_TEST_MAX_RESULTS=120

# --- Observability (Milestone 6) ------------------------------------------
# Database traces always record. OTLP export is opt-in; leave the endpoint
# empty to keep spans in-process (no collector required).
OTEL_TRACING_ENABLED=true
OTEL_SERVICE_NAME=modelscope-ai
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
#
# Estimated costs are produced only for entries you configure here. There are
# no built-in vendor prices. Value is a JSON object keyed by
# "<provider kind>:<model id>", each with input_per_million,
# output_per_million and currency. Leave empty to report costs as unavailable.
EXECUTION_PRICING=
# Completed days are pre-aggregated for the dashboard. The default of 0 keeps
# raw traces forever; set a positive number of complete days to delete raw
# traces after that window. Rollup history is retained regardless.
OBSERVABILITY_ROLLUP_ENABLED=true
OBSERVABILITY_TRACE_RETENTION_DAYS=0

# --- Database backups (production profile) --------------------------------
# BACKUP_ENABLED schedules a daily pg_dump through Celery Beat. The dev profile
# leaves it off. BACKUP_DIR is a path inside the backend/beat containers.
BACKUP_ENABLED=false
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# --- Production-only settings (not used by the Compose dev profile) --------
# Set DJANGO_SETTINGS_MODULE=config.settings.prod and terminate TLS at a trusted
# proxy before enabling this; see docs/OPERATIONS.md. Production Compose runs
# with the `docker-compose.prod.yml` profile.
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# GUNICORN_WORKERS=4
# CELERY_CONCURRENCY=4
# APP_PORT=8080
