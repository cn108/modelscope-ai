# ModelScope AI — local development environment template.
#
# Copy this file to the repository root and replace the placeholder values:
#   cp .env.example .env
#
# .env is ignored by git and must never be committed. Compose reads it from the
# repository root; use:
#   docker compose -f infrastructure/docker-compose.yml --env-file .env up --build

# --- Django ---------------------------------------------------------------
# Generate a real value for anything beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=modelscope
POSTGRES_USER=modelscope
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# Compose overrides the host with the internal `db` service name.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Unit-test convenience only. Leave unset for Compose; PostgreSQL is the source
# of truth.
# DATABASE_ENGINE=sqlite

# --- Redis / Celery -------------------------------------------------------
# Compose overrides this with redis://redis:6379/0 inside containers.
REDIS_URL=redis://localhost:6379/0
# Leave these unset so both fall back to REDIS_URL. If you set them, use the
# Compose-internal hostname (`redis`) for container runs.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- API / authentication -------------------------------------------------
JWT_ACCESS_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# --- Provider credential encryption (Milestone 3) ------------------------
# Comma-separated Fernet keys, current key first. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty until provider credential storage is implemented.
PROVIDER_SECRET_KEYS=

# --- Production-only settings (not used by the Compose dev profile) ------
# SECURE_SSL_REDIRECT=true
